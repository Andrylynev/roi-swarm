# ROI Swarm — секреты и параметры запуска. Скопируйте в .env (chmod 600).
# install.sh заполняет этот файл сам.

# OpenAI-совместимый провайдер моделей (обязательно)
ROI_PROVIDER_BASE_URL=https://provider.example/v1
ROI_PROVIDER_API_KEY=replace_me

# Bearer-токен для /v1 и /dashboard (обязателен, если ROI_HOST не 127.0.0.1)
ROI_SWARM_API_KEY=replace_me

# Где слушать сервер
ROI_HOST=127.0.0.1
ROI_PORT=8765

# Необязательно
# ROI_SLEEP_ENABLED=false        # режим сна (самоулучшение во время простоя)
# ROI_SLEEP_AUTO_IMPROVE=false   # автокоммиты улучшений после тестов и ревью
# ROI_RAG_EMBEDDINGS=false       # векторный RAG, нужен `uv sync --extra embeddings`
